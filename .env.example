# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
# Generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Stripe (one-time lifetime payment for peso-log Pro)
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. For local dev use `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Price ID of the "peso-log Pro Lifetime" one-time product
STRIPE_PRICE_PRO_LIFETIME=