# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
# Generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Comma-separated list of origins allowed for callbacks/redirects
# Example: http://localhost:3000,https://app.example.com
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (one-time lifetime payment for Vitta Pro)
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. For local dev use `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Price ID of the "Vitta Pro Lifetime" one-time product
STRIPE_PRICE_PRO_LIFETIME=